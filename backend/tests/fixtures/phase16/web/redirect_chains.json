     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "custom_port", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://port.example:8443/"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "space_in_location", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://ok.example/a b"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "javascript_scheme", "serve": [{"url": "https://start.example/a", "status": 302, "location": "javascript:alert(1)"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "file_scheme", "serve": [{"url": "https://start.example/a", "status": 302, "location": "file:///etc/passwd"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "use_proxy_305", "serve": [{"url": "https://start.example/a", "status": 305, "location": "https://proxy.example/"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects in a way Pebble does not follow"}},
    {"id": "missing_location", "serve": [{"url": "https://start.example/a", "status": 302, "location": ""}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects in a way Pebble does not follow"}},
    {"id": "loop", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://b.example/x"},
                             {"url": "https://b.example/x", "status": 302, "location": "https://start.example/a"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example", "b.example"], "message": "redirects in a loop"}},
    {"id": "four_redirects", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://b.example/"},
                                       {"url": "https://b.example/", "status": 302, "location": "https://c.example/"},
                                       {"url": "https://c.example/", "status": 302, "location": "https://d.example/"},
                                       {"url": "https://d.example/", "status": 302, "location": "https://e.example/"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example", "b.example", "c.example", "d.example"], "message": "redirected more than 3 times"}},
    {"id": "three_redirects_followed", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://b.example/"},
                                                 {"url": "https://b.example/", "status": 301, "location": "https://c.example/"},
                                                 {"url": "https://c.example/", "status": 308, "location": "/final"},
                                                 {"url": "https://c.example/final", "status": 200, "content_type": "text/html; charset=utf-8",
                                                  "body": "<!doctype html><html><body><p>P16-REDIRECT-FINAL</p></body></html>"}],
     "dns": {},
     "expect": {"outcome": "followed", "contacted": ["start.example", "b.example", "c.example", "c.example"],
                "final_url": "https://c.example/final", "redirects": ["https://b.example/", "https://c.example/", "https://c.example/final"],
                "text_contains": "P16-REDIRECT-FINAL"}}
  ]
}
