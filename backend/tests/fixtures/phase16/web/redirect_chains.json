{
  "format": "pebble-p16-fixture/1",
  "case": "W3",
  "gate": "G3",
  "owner": ["T1"],
  "title": "Redirect chains into private, loopback and non-https destinations",
  "how": "Serve each 'serve' entry from a fake resolver and HTTPS peer (no network). Hosts not listed in 'dns' resolve to public_ip. 'contacted' is every host that received a request, in order; a refused chain must never contact the private hop.",
  "public_ip": "93.184.216.34",
  "start": "https://start.example/a",
  "chains": [
    {"id": "rfc1918_host", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://intranet.example/admin"}],
     "dns": {"intranet.example": ["10.0.0.5"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "loopback_literal", "serve": [{"url": "https://start.example/a", "status": 301, "location": "https://127.0.0.1/admin"}],
     "dns": {"127.0.0.1": ["127.0.0.1"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "ipv6_loopback", "serve": [{"url": "https://start.example/a", "status": 307, "location": "https://[::1]/"}],
     "dns": {"::1": ["::1"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "metadata_link_local", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://169.254.169.254/latest/meta-data/"}],
     "dns": {"169.254.169.254": ["169.254.169.254"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "cgnat_shared", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://cgnat.example/"}],
     "dns": {"cgnat.example": ["100.64.0.7"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "ipv4_mapped_ipv6", "serve": [{"url": "https://start.example/a", "status": 308, "location": "https://[::ffff:127.0.0.1]/"}],
     "dns": {"::ffff:127.0.0.1": ["::ffff:127.0.0.1"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "unspecified_address", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://0.0.0.0/"}],
     "dns": {"0.0.0.0": ["0.0.0.0"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "decimal_ip", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://2130706433/"}],
     "dns": {"2130706433": ["127.0.0.1"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "localhost_name", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://localhost/"}],
     "dns": {"localhost": ["127.0.0.1"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "rebinding_mixed_answer", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://rebind.example/"}],
     "dns": {"rebind.example": ["93.184.216.34", "192.168.1.10"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "protocol_relative", "serve": [{"url": "https://start.example/a", "status": 302, "location": "//intranet.example/x"}],
     "dns": {"intranet.example": ["10.0.0.5"]},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "second_hop_private", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://hop.example/b"},
                                           {"url": "https://hop.example/b", "status": 302, "location": "https://intranet.example/c"}],
     "dns": {"intranet.example": ["10.0.0.5"]},
     "expect": {"outcome": "refused", "contacted": ["start.example", "hop.example"], "message": "Only public HTTPS sources are allowed"}},
    {"id": "http_downgrade", "serve": [{"url": "https://start.example/a", "status": 302, "location": "http://plain.example/"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
    {"id": "userinfo", "serve": [{"url": "https://start.example/a", "status": 302, "location": "https://user:pw@cred.example/"}],
     "dns": {},
     "expect": {"outcome": "refused", "contacted": ["start.example"], "message": "redirects to an address Pebble does not read"}},
